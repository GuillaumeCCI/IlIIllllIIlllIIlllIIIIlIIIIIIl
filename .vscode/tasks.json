{
  // À l'ouverture du dossier dans VS Code : récupère ce qui a été envoyé sur
  // GitHub depuis l'autre ordinateur. « --ff-only » : si les deux versions
  // ont divergé, rien n'est touché et un message l'indique.
  // Pas de « git pull » : il relit le fichier FETCH_HEAD, que la vérification
  // automatique de VS Code (git.autofetch) remplit en même temps, d'où
  // l'erreur « Cannot fast-forward to multiple branches ». La fusion se fait
  // donc directement sur origin/main.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Récupérer depuis GitHub",
      "type": "shell",
      "command": "git fetch origin main; if ($?) { git merge --ff-only origin/main }",
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "silent", "panel": "dedicated", "close": false },
      "problemMatcher": []
    }
  ]
}
