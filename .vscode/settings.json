  // placés à côté d'Atelier-Vente-1-1-1.
  "liveServer.settings.root": "/.vscode/go-live",
  "liveServer.settings.mount": [
    ["/1-1-1", "."],
    ["/1-1-2", "../../Atelier-Vente-1-1-2/atelier-vente"],
    ["/1-1-3", "../../Atelier-Vente-1-1-3/atelier-vente"],
    ["/1-1-4", "../../Atelier-Vente-1-1-4/atelier-vente"]
  ]
}
